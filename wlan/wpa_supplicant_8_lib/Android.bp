cc_library_static {
    name: "lib_driver_cmd_mt66xx",
    vendor: true,
    sanitize: {
        cfi: true,
    },
    // This library dereferences wpa_supplicant's private structures
    // (struct wpa_supplicant, wpa_global, wpa_ssid), whose layout depends on
    // CONFIG_* flags. Compile it with the flags of the wpa_supplicant binary it
    // is linked into, or it reads fields at the wrong offsets.
    // wpa_supplicant_usd_defaults: CONFIG_NAN_USD, and since Android 17 also
    // CONFIG_NAN, which adds fields to struct wpa_supplicant and the nl80211
    // driver structs.
    defaults: [
        "wpa_supplicant_cflags_default",
        "wpa_supplicant_usd_defaults",
    ],
    cflags: [
        "-DCONFIG_MTK_P2P_SIGMA",
        // The shared defaults add -Werror; this imported code is not
        // warning-clean against them.
        "-Wno-error",
    ],
    srcs: ["mediatek_driver_cmd_nl80211.c"],
    shared_libs: [
        "libc",
        "libcutils",
    ],
    include_dirs: [
        "external/wpa_supplicant_8/src",
        "external/wpa_supplicant_8/src/common",
        "external/wpa_supplicant_8/src/drivers",
        "external/wpa_supplicant_8/src/l2_packet",
        "external/wpa_supplicant_8/src/utils",
        "external/wpa_supplicant_8/src/wps",
        "external/wpa_supplicant_8/wpa_supplicant",
        "external/libnl/include",
    ],
}
